@model IEnumerable<DigitalFormsSystem.Core.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">
    <h1>
        <i class="fas fa-history"></i> Audit Logs
    </h1>
    <hr />

    <p class="text-muted">
        <i class="fas fa-info-circle"></i> Showing last 100 logs
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date/Time</th>
                    <th>User</th>
                    <th>Employee No.</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(log.UserName ?? "Unknown")</td>
                        <td>@(log.EmployeeNo ?? "-")</td>
                        <td>
                            <span class="badge @(log.Action == "Login" ? "bg-success" : 
                                                  log.Action == "LoginFailed" ? "bg-danger" : 
                                                  log.Action == "Delete" ? "bg-danger" : 
                                                  log.Action == "Edit" ? "bg-warning" : 
                                                  log.Action == "Create" ? "bg-primary" : 
                                                  log.Action == "Print" ? "bg-info" : 
                                                  log.Action == "Logout" ? "bg-secondary" : "bg-secondary")">
                                @log.Action
                            </span>
                        </td>
                        <td>@(log.EntityType ?? "-")</td>
                        <td>@log.Details</td>
                        <td>@log.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No audit logs found.
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>