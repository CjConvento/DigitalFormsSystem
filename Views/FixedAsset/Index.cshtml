@model IEnumerable<DigitalFormsSystem.Core.Models.FixedAssetRequest>
@inject DigitalFormsSystem.Core.Interfaces.ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = "Fixed Asset Requests";
    var isManager = CurrentUserService.EmployeeId == 778; // Gilbert's ID
}

<h1>Fixed Asset Requests</h1>

<!-- ✅ ROLE-BASED ALERT -->
@if (isManager)
{
    <div class="alert alert-info">
        <i class="fas fa-user-shield"></i> 
        <strong>Admin View:</strong> You are seeing ALL requests from ALL employees.
        <span class="badge bg-primary float-end">Total: @Model.Count()</span>
    </div>
}
else
{
    <div class="alert alert-secondary">
        <i class="fas fa-user"></i> 
        <strong>My Requests:</strong> You are seeing only your own requests.
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Request</a>
</p>

<!-- rest of the table -->
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Control No</th>
            <th>Date Requested</th>
            <th>Department</th>
            <th>Section</th>
            <th>Asset Type</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ControlNo</td>
                <td>@item.DateRequested.ToString("yyyy-MM-dd")</td>
                <td>@item.Department</td>
                <td>@item.Section</td>
                <td>@item.AssetType</td>
                <td>@item.Quantity</td>
                <td>
                    <span class="badge @(item.RequestStatus == "Draft" ? "bg-warning" : "bg-success")">
                        @item.RequestStatus
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Print" asp-route-id="@item.Id" class="btn btn-sm btn-secondary" target="_blank">Print</a>
                    @if (item.RequestStatus == "Draft")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No requests found.
        <a asp-action="Create">Create your first request</a>
    </div>
}