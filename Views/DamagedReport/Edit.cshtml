@model DigitalFormsSystem.Core.Models.DamagedReport
@{
    ViewData["Title"] = "Edit Damaged Report";
    var employees = ViewBag.Employees as SelectList;
    var isGad = Context.Session.GetString("EmployeeDepartment") == "GAD";
}

<h1>Edit Damaged Report</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Detailed errors:</strong>
        <ul>
            @foreach (var key in ViewData.ModelState.Keys)
            {
                var errors = ViewData.ModelState[key]?.Errors;
                if (errors != null && errors.Any())
                {
                    foreach (var error in errors)
                    {
                        <li>@key: @error.ErrorMessage</li>
                    }
                }
            }
        </ul>
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (ViewData.ModelState.ContainsKey("partIimages") || ViewData.ModelState.ContainsKey("partIIimages"))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Image upload problem:</strong> One or more of the selected images are invalid (wrong type, too large). Please check and re-upload.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* PART I – ITEM DESCRIPTION *@
    <div class="section" style="border:1px solid #ccc; padding:10px; margin-bottom:20px;">
        <h4>PART I – ITEM DESCRIPTION</h4>

        <!-- Modern upload card (placed first) -->
        <div class="upload-card" id="uploadCardPartI">
            <i class="fas fa-plus-circle"></i>
            <p>Upload Image</p>
            <small class="text-muted">Click to select additional item pictures</small>
        </div>
        <input type="file" name="partIimages" id="partIimages" multiple accept="image/*" class="hidden-file-input" />
        @Html.ValidationMessage("partIimages", new { @class = "text-danger" })
        <div id="edit-partI-images-preview" class="row mt-2"></div>

        <!-- Existing images (with delete and preview) -->
        @if (Model.Images != null && Model.Images.Any(i => i.Section == "PartI"))
        {
            <div class="mt-3">
                <label>Current Item Pictures:</label>
                <div class="row" id="existingPartIContainer">
                    @foreach (var img in Model.Images.Where(i => i.Section == "PartI"))
                    {
                        <div class="col-md-3 mb-2 existing-image-item" data-image-id="@img.Id">
                            <div class="image-preview-card">
                                <img src="@img.FilePath" class="card-img-top" style="max-height:120px; object-fit:cover;" />
                                <div class="card-body p-1 text-center">
                                    <span class="remove-existing-btn" style="cursor:pointer; color:red; display:inline-block;">Remove</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Original text fields (unchanged) -->
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Item" class="control-label"></label>
                    <input asp-for="Item" class="form-control" required />
                </div>
                <div class="form-group">
                    <label asp-for="FixedAssetCode" class="control-label"></label>
                    <input asp-for="FixedAssetCode" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="DatePurchased" class="control-label"></label>
                    <input asp-for="DatePurchased" class="form-control" type="date" />
                </div>
                <div class="form-group">
                    <label asp-for="BrandSize" class="control-label"></label>
                    <input asp-for="BrandSize" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="LocationUser" class="control-label"></label>
                    <input asp-for="LocationUser" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="SerialNumber" class="control-label"></label>
                    <input asp-for="SerialNumber" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Color" class="control-label"></label>
                    <input asp-for="Color" class="form-control" type="color" />
                </div>
            </div>
        </div>
    </div>

    @* PART II – INCIDENT REPORT *@
    <div class="section" style="border:1px solid #ccc; padding:10px; margin-bottom:20px;">
        <h4>PART II – INCIDENT REPORT</h4>

        <!-- Modern upload card (placed first) -->
        <div class="upload-card" id="uploadCardPartII">
            <i class="fas fa-plus-circle"></i>
            <p>Upload Image</p>
            <small class="text-muted">Click to select additional incident pictures</small>
        </div>
        <input type="file" name="partIIimages" id="partIIimages" multiple accept="image/*" class="hidden-file-input" />
        @Html.ValidationMessage("partIIimages", new { @class = "text-danger" })
        <div id="edit-partII-images-preview" class="row mt-2"></div>

        <!-- Existing images (with delete and preview) -->
        @if (Model.Images != null && Model.Images.Any(i => i.Section == "PartII"))
        {
            <div class="mt-3">
                <label>Current Item Pictures:</label>
                <div class="row" id="existingPartIIContainer">
                    @foreach (var img in Model.Images.Where(i => i.Section == "PartII"))
                    {
                        <div class="col-md-3 mb-2 existing-image-item" data-image-id="@img.Id">
                            <div class="image-preview-card">
                                <img src="@img.FilePath" class="card-img-top" style="max-height:120px; object-fit:cover;" />
                                <div class="card-body p-1 text-center">
                                    <span class="remove-existing-btn" style="cursor:pointer; color:red; display:inline-block;">Remove</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Original text fields (unchanged, but moved after the image area) -->
        <div class="row mt-4">
            <div class="col-md-6">
                <!-- INCIDENT -->
                <div class="form-group">
                    <label asp-for="IncidentDateTime" class="control-label"></label>
                    <div class="row">
                        <div class="col-md-6">
                            <input type="text" id="IncidentDate" class="form-control" placeholder="Petsa" readonly
                                   value="@(Model.IncidentDateTime?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-6">
                            <input type="text" id="IncidentTime" class="form-control" placeholder="Oras" readonly
                                   value="@(Model.IncidentDateTime?.ToString("hh:mm tt"))">
                        </div>
                    </div>
                    <input type="hidden" asp-for="IncidentDateTime" />
                    <span asp-validation-for="IncidentDateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CauseOfDamage" class="control-label"></label>
                    <textarea asp-for="CauseOfDamage" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ImmediateAction" class="control-label"></label>
                    <textarea asp-for="ImmediateAction" class="form-control" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="RecommendedAction" class="control-label"></label>
                    <select asp-for="RecommendedAction" class="form-control">
                        <option value="">-- Select --</option>
                        <option value="1">Internal Repair</option>
                        <option value="2">External Repair</option>
                        <option value="3">Parts for Replacement</option>
                        <option value="4">Disposal</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="ReceivedByEmployeeId" class="control-label">Received by (optional)</label>
                    <select asp-for="ReceivedByEmployeeId" class="form-control" asp-items="employees">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <!-- RECEIVED -->
                <div class="form-group">
                    <label asp-for="ReceivedDateTime" class="control-label">Received date/time</label>
                    <div class="row">
                        <div class="col-md-6">
                            <input type="text" id="ReceivedDate" class="form-control" placeholder="Petsa" readonly
                                   value="@(Model.ReceivedDateTime?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-6">
                            <input type="text" id="ReceivedTime" class="form-control" placeholder="Oras" readonly
                                   value="@(Model.ReceivedDateTime?.ToString("hh:mm tt"))">
                        </div>
                    </div>
                    <input type="hidden" asp-for="ReceivedDateTime" />
                    <span asp-validation-for="ReceivedDateTime" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    @* PART IV – FOLLOW-UP STATUS (To be filled-up by GAD only) *@
    @if (isGad)
    {
        <div class="section" style="border:1px solid #ccc; padding:10px; margin-bottom:20px;">
            <h4>PART IV – FOLLOW-UP STATUS (To be filled-up by GAD only)</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Findings"></label>
                        <textarea asp-for="Findings" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="Recommendation"></label>
                        <textarea asp-for="Recommendation" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="NegligenceFlag"></label>
                        <select asp-for="NegligenceFlag" class="form-control">
                            <option value="">-- Select --</option>
                            <option value="1">Negligence of user/in-charge</option>
                            <option value="2">Not negligence</option>
                            <option value="3">Others</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="NegligenceDetails"></label>
                        <input asp-for="NegligenceDetails" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Remarks"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="AdministrativeDiscipline"></label>
                        <select asp-for="AdministrativeDiscipline" class="form-control">
                            <option value="">-- Select --</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="InvestigatedByEmployeeId"></label>
                        <select asp-for="InvestigatedByEmployeeId" class="form-control" asp-items="employees">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="VerifiedByEmployeeId"></label>
                        <select asp-for="VerifiedByEmployeeId" class="form-control" asp-items="employees">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="NotedByEmployeeId"></label>
                        <select asp-for="NotedByEmployeeId" class="form-control" asp-items="employees">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    @* SUBMIT *@
    <div class="form-group mt-3">
        <input type="submit" value="Save Changes" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/edit-image-preview.js"></script>
    <script src="~/js/edit-formdatetime.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
}